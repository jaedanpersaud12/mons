# Neon Postgres. Leave unset to use the ../game-docs folder instead.
DATABASE_URL=
# Neon Realtime (Console: Postgres database > Realtime)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Passcode for the deployed site. Leave unset locally.
APP_PASSCODE=

# Token for the MCP server at /api/mcp (vercel-setup.sh generates one). Falls back to APP_PASSCODE.
MCP_TOKEN=
